{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outcome Exchange Evaluation",
  "type": "object",
  "required": ["first_pass_acceptance", "evidence_completeness", "rework_rate", "cost_per_accepted_outcome_usd"],
  "properties": {
    "first_pass_acceptance": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "rework_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "cost_per_accepted_outcome_usd": {"type": ["number", "null"], "minimum": 0}
  }
}
